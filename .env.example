# Copy this file to .env and fill in the values you need.
# The project loads .env automatically when importing rag_v1.
# Existing shell environment variables take precedence over values in .env.

# Required for the visual language model call.
# CHAT_API_KEY takes precedence; DASHSCOPE_API_KEY is used as fallback.
DASHSCOPE_API_KEY=
CHAT_API_KEY=
CHAT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3-vl-8b-instruct
CHAT_API_MODE=chat_completions
CHAT_MAX_RETRIES=2
CHAT_CONNECT_TIMEOUT=10
CHAT_READ_TIMEOUT=120

# Required for web search retrieval.
WEB_SEARCH_PROVIDER=serpapi
BOCHA_API_KEY=
BOCHA_API_URL=https://api.bochaai.com/v1/web-search
BOCHA_TIMEOUT=20
SERPAPI_API_KEY=
SERPAPI_API_URL=https://serpapi.com/search.json
SERPAPI_TIMEOUT=20
SERPAPI_ENGINE=google
SERPAPI_GOOGLE_DOMAIN=google.com
SERPAPI_GL=us
SERPAPI_HL=en
SERPAPI_LOCATION=
SERPAPI_NO_CACHE=false

# Local CLIP embedding service.
CLIP_SERVER_HOST=127.0.0.1
CLIP_SERVER_PORT=8001
CLIP_SERVER_REQUEST_TIMEOUT=120
CLIP_MODEL_ID=openai/clip-vit-base-patch32
CLIP_LOCAL_MODEL_DIR=
CLIP_IMAGE_TIMEOUT=20

# Local sentence-transformers text retrieval service.
TEXT_RETRIEVAL_SERVER_HOST=127.0.0.1
TEXT_RETRIEVAL_SERVER_PORT=8002
TEXT_RETRIEVAL_SERVER_REQUEST_TIMEOUT=120
TEXT_RETRIEVAL_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TEXT_RETRIEVAL_LOCAL_MODEL_DIR=
TEXT_RETRIEVAL_BATCH_SIZE=32

# Hugging Face mirror or endpoint for model downloads.
HF_ENDPOINT=https://hf-mirror.com
# CLIP_HF_ENDPOINT=
# TEXT_RETRIEVAL_HF_ENDPOINT=

# Web page fetching and cache.
WEB_FETCH_ENABLED=true
WEB_FETCH_TIMEOUT=18
WEB_FETCH_MAX_RETRIES=2
WEB_FETCH_CACHE_TTL_SECONDS=604800
WEB_FETCH_MAX_BYTES=2500000
WEB_FETCH_MIN_TEXT_CHARS=300
WEB_FETCH_CACHE_DIR=

# Evidence ranking.
IMAGE_MATCH_THRESHOLD=0.5
